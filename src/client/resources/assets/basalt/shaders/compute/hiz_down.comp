#version 460
// Next Hi-Z level: MIN of the 2x2 (3x3 at odd edges) texels of the previous level.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, r32f) uniform readonly image2D src;
layout(binding = 1, r32f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 srcSize; ivec2 dstSize; } p;

void main() {
    ivec2 d = ivec2(gl_GlobalInvocationID.xy);
    if (d.x >= p.dstSize.x || d.y >= p.dstSize.y) return;
    ivec2 s = d * 2;
    int ex = (d.x == p.dstSize.x - 1 && (p.srcSize.x & 1) == 1) ? 2 : 1;
    int ey = (d.y == p.dstSize.y - 1 && (p.srcSize.y & 1) == 1) ? 2 : 1;
    float m = 1.0;
    for (int y = 0; y <= ey; y++) {
        for (int x = 0; x <= ex; x++) {
            m = min(m, imageLoad(src, min(s + ivec2(x, y), p.srcSize - 1)).r);
        }
    }
    imageStore(dst, d, vec4(m));
}
